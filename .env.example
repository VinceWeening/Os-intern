# Local development / Vercel Development & Preview: use your TEST project.
# The publishable key is public by design. Never put secret/service-role keys here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Must match project_ref in the Supabase URL; prevents accidental project mixups.
NEXT_PUBLIC_SUPABASE_PROJECT_REF=
NEXT_PUBLIC_APP_ENV=test
